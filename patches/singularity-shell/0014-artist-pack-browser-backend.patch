+                        return;
+                    }
+                    btn.label = _("Install Failed");
+                    GLib.Timeout.add_seconds(4, () => {
+                        if (gen != artist_pack_refresh_generation) return GLib.Source.REMOVE;
+                        btn.label = _("Install");
+                        btn.sensitive = true;
+                        return GLib.Source.REMOVE;
+                    });
+                }
+            });
+        }
+
