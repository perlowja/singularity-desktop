+      <description>
+        Tile ids shown in the quick settings panel. Registered ids are wifi,
+        bluetooth, theme, night-light, airplane-mode, keyboard-light, audio,
+        power-profile, do-not-disturb, vpn, tiling, hotspot and game-mode.
+        Defaulted to the common subset rather than an empty list, because
+        tile_is_active() returns false for everything when the list is empty and
+        the panel would render with no tiles at all.
+      </description>
+    </key>
+    <key name="quick-settings-tile-order" type="as">
+      <default>[]</default>
+      <summary>Quick settings tile order</summary>
+      <description>
+        Explicit ordering of tile ids. Empty is safe here, unlike the active
+        list: tile_order() appends any unlisted registered tiles after the
+        ordered ones, so an empty value yields registration order.
+      </description>
+    </key>
+    <key name="night-light-enabled" type="b">
+      <default>false</default>
+      <summary>Night Light enabled</summary>
+      <description>
+        Master switch for Night Light. Added along with the other
+        night-light-* keys below when NightLightManager was reworked from a
+        hard-coded 4000 K on/off toggle into a settings-driven state machine
+        -- these keys did not exist before that rework and their absence
+        aborts (SIGABRT, GSettings unknown-key) the moment
+        SystemMonitor.get_night_light() is called, which happens on first
+        sidebar construction. Same failure class as the window-border-width
+        / tiling-spacing note above.
+      </description>
+    </key>
+    <key name="night-light-adaptive" type="b">
+      <default>false</default>
+      <summary>Night Light adaptive scheduling</summary>
+      <description>
+        When true, Night Light activates automatically between
+        night-light-adaptive-from and night-light-adaptive-to instead of
+        following night-light-enabled directly.
+      </description>
+    </key>
+    <key name="night-light-temperature" type="i">
+      <default>4000</default>
+      <summary>Night Light color temperature (Kelvin)</summary>
+      <description>
+        Clamped to 1000-6500 K by NightLightManager. 4000 matches the value
+        the old hard-coded toggle used.
+      </description>
+    </key>
+    <key name="night-light-adaptive-from" type="s">
+      <default>"19:00"</default>
+      <summary>Night Light adaptive schedule start (HH:MM)</summary>
+      <description>Only read when night-light-adaptive is true.</description>
+    </key>
+    <key name="night-light-adaptive-to" type="s">
+      <default>"07:00"</default>
+      <summary>Night Light adaptive schedule end (HH:MM)</summary>
+      <description>Only read when night-light-adaptive is true.</description>
+    </key>
   </schema>
 </schemalist>
diff --git a/data/systemd/xdg-desktop-portal-singularity.service b/data/systemd/xdg-desktop-portal-singularity.service
index 8b0521d..856c5a1 100644
--- a/data/systemd/xdg-desktop-portal-singularity.service
+++ b/data/systemd/xdg-desktop-portal-singularity.service
@@ -6,6 +6,14 @@ After=graphical-session.target
 [Service]
 Type=dbus
 BusName=org.freedesktop.impl.portal.desktop.singularity
+# GSettings only searches XDG_DATA_DIRS (plus /usr/share) for schemas by
+# default. None of this unit's own install prefixes are on that path unless
+# something else adds them, so every gsettings call -- including the ones the
+# Settings portal makes on construction -- fails "No such schema" and aborts
+# (g_settings_new is a fatal error, not a catchable one). Listing every
+# prefix this ExecStart already searches for the binary keeps the two lists
+# in sync regardless of which one actually wins.
+Environment=XDG_DATA_DIRS=/opt/singularity/share:/opt/local/share:/opt/share:%h/.local/singularity/share:/usr/local/share:/usr/share
 ExecStart=/bin/sh -c 'for d in /opt/local/bin /opt/bin /usr/local/bin %h/.local/singularity/bin /usr/bin; do if [ -x "$d/xdg-desktop-portal-singularity" ]; then exec "$d/xdg-desktop-portal-singularity"; fi; done; exit 1'
 Restart=on-failure
 RestartSec=2
