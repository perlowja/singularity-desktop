+void
+tod_shared_drivers_register (void)
+{
+  g_auto(GStrv) dirnames = NULL;
+  guint i;
+
+  g_assert_null (shared_drivers);
+
+  shared_drivers = g_array_new (TRUE, FALSE, sizeof (GType));
+  dirnames = get_tod_drivers_dirs ();
